{
  "paths": {
    "/extended/{area}": {
      "get": {
        "operationId": "libraryshareExtendedRead",
        "parameters": [
          {"name":"area","in":"path","type":"string","required":true},
          {"name":"patron_id","in":"query","type":"integer","required":false},
          {"name":"listing_id","in":"query","type":"integer","required":false},
          {"name":"review_id","in":"query","type":"integer","required":false},
          {"name":"request_id","in":"query","type":"integer","required":false}
        ],
        "produces":["application/json"],
        "responses":{"200":{"description":"Requested data","schema":{"type":"object"}},"default":{"description":"Request error","schema":{"type":"object"}}},
        "x-mojo-to":"Koha::Plugin::Com::LibraryShare::Controller::Extended#dispatch"
      },
      "post": {
        "operationId": "libraryshareExtendedWrite",
        "parameters": [
          {"name":"area","in":"path","type":"string","required":true},
          {"name":"body","in":"body","required":true,"schema":{"type":"object"}}
